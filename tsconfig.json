{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",                      // ESNext ko badal kar CommonJS karein
    "rootDir": "./src",
    "outDir": "./dist",
    "jsx": "react-native",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}